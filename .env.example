# GitHub API Token (Optional, for higher rate limits up to 5,000 req/hr)
# Without a token, GitHub allows 60 requests/hour unauthenticated.
# The platform also includes comprehensive mock/curated profiles.
GITHUB_TOKEN=

# SQLite Database Path (Default is data/developer_intelligence.db)
DATABASE_PATH=data/developer_intelligence.db

# Cache TTL in hours
CACHE_TTL_HOURS=24
